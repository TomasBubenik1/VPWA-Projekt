    class User {
        firstName
        lastName
        nickname
        email
        password
        presence
        notificationMode
    }
    class Channel {
        name
        type
    }
    class Message {
        content
        sentAt
    }
    class Invitation {
        status
        sentAt
    }

    User "1" -- "0..*" Channel : spravuje
    User "1..*" -- "0..*" Channel : je členom
    User "1" -- "0..*" Message : odosiela
    Channel "1" -- "0..*" Message : obsahuje
    Message "0..*" -- "0..*" User : adresuje cez @nickname
    User "1" -- "0..*" Invitation : pozýva
    User "1" -- "0..*" Invitation : je pozvaný
    Channel "1" -- "0..*" Invitation : pozvánka do
    User "0..*" -- "0..*" Channel : má zákaz vstupu

    note for User "presence: online, dnd, offline<br/>notificationMode: all, mentionsOnly"
    note for Channel "type: public, private<br/>Správca je tvorca kanála a jeho člen.<br/>Po 30 dňoch bez správy kanál zaniká."
