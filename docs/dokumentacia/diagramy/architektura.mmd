flowchart TB
  subgraph Klient["Prehliadač: Quasar SPA (Vue 3, TypeScript)"]
    direction LR
    UI["Stránky a komponenty<br/>AuthPanel, ChannelSidebar,<br/>ChatWorkspace, CommandDock"]
    State["workspace.ts: reaktívny stav<br/>účet, kanály, správy"]
    Http["api.ts: HTTP klient<br/>fetch, Bearer token"]
    Ws["WebSocket klient<br/>@rlanz/socket/client"]
    Vis["App Visibility<br/>a Notification API"]
