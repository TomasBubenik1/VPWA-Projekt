    Routes["start/routes.ts<br/>/api/v1"]
    Mw["Middleware<br/>auth, activeChannels"]
    Ctrl["Kontroléry<br/>účet, kanály, pozvánky, správy"]
    Val["Validátory VineJS"]
    Svc["Služby<br/>channels, socket_tickets,<br/>channel_connections"]
    WsCh["WebSocket kanály<br/>channels/:id, users/:id"]
    Lucid["Lucid ORM<br/>modely a query builder"]
    Routes --> Mw --> Ctrl
    Ctrl --> Val
    Ctrl --> Svc
    Ctrl --> Lucid
    Svc --> Lucid
    Svc -- "udalosti" --> WsCh
  end

  DB[("SQLite<br/>migrácie")]

  Http -- "REST JSON" --> Routes
